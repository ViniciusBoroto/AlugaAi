/nullable:enable
/debug+
/debug:portable
/filealign:512
/optimize-
/out:obj/Debug/net10.0/AlugaAi.dll
/refout:obj/Debug/net10.0/refint/AlugaAi.dll
/target:exe
/warnaserror-
/utf8output
/deterministic+
/warnaserror+:NU1605,SYSLIB0011

